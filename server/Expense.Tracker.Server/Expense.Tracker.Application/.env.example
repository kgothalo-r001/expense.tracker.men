# Environment Variables for Expense Tracker

# JWT Configuration
# Generate a strong secret key (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters

# Database Configuration (optional - can use appsettings.json instead)
# DATABASE_URL=Host=127.0.0.1;Database=expense_tracker;Username=postgres;Password=postgres

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
