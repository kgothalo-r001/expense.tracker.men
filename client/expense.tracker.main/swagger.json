  "components": {
    "schemas": {
      "BudgetProjection": {
        "type": "object",
        "properties": {
          "projectedMonthlyExpenses": {
            "type": "number",
            "format": "double"
          },
          "projectedYearlyExpenses": {
            "type": "number",
            "format": "double"
          },
          "recommendedMonthlySavings": {
            "type": "number",
            "format": "double"
          },
          "categoryProjections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryProjection"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Category": {
        "required": [
          "color",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "color": {
